{
  "name": "@wayfind/mcp",
  "version": "0.1.0",
  "description": "MCP server that gives AI agents Wayfind's tokens, component docs and a design-system linter.",
  "type": "module",
  "bin": {
    "wayfind-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "start": "node dist/bin.js",
    "start:http": "node dist/bin.js --http",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@wayfind/react": "workspace:*",
    "@wayfind/tokens": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
