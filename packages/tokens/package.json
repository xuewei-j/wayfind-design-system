{
  "name": "@wayfind/tokens",
  "version": "0.1.0",
  "description": "Wayfind design tokens: DTCG source, resolved JS API, CSS custom properties and WCAG contrast contract.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./source.json": "./src/tokens.json"
  },
  "files": ["dist", "src/tokens.json"],
  "scripts": {
    "build": "tsup && tsx scripts/build-css.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
