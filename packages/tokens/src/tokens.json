{
  "$description": "Wayfind design tokens (W3C DTCG format). Single source of truth for CSS, the React library, Storybook and the MCP server. Primitives live under `palette`; components only consume semantic `color.*` tokens and the scales.",
  "palette": {
    "$type": "color",
    "$description": "Primitive colors. Never referenced directly by components — use semantic `color.*` tokens instead.",
    "orange": {
      "$description": "Brand hue, built around the product design system's Brand / Primary #BA4300.",
      "50": { "$value": "#fff8f3" },
      "100": { "$value": "#fae0cf" },
      "200": { "$value": "#f5c3a2" },
      "300": { "$value": "#eda172" },
      "400": { "$value": "#e07b42", "$description": "Light orange. 2.97:1 with white text, so it is never a white-text button. Used as the dark-mode accent fill with dark text." },
      "500": { "$value": "#d95f27", "$description": "Bright orange. 3.74:1 with white text: below AA for button labels, so it is not used for CTAs." },
      "600": { "$value": "#ba4300", "$description": "Brand / Primary. 5.40:1 with white text, so it is the CTA fill." },
      "700": { "$value": "#9a3700" },
      "800": { "$value": "#7a2c00" },
      "900": { "$value": "#4f1d00" },
      "950": { "$value": "#2e1100" }
    },
    "neutral": {
      "$description": "Grays from the product design system: Text / Primary #0D0D0D, Secondary #5D5D5D, Tertiary #8F8F8F, and the #E8E8E8 / #F3F3F3 fills.",
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f3f3f3", "$description": "Brand / Tertiary." },
      "100": { "$value": "#e8e8e8", "$description": "Brand / Secondary." },
      "200": { "$value": "#dedede" },
      "300": { "$value": "#c4c4c4" },
      "400": { "$value": "#8f8f8f", "$description": "Text / Tertiary. 3.23:1 on white, so in light mode it is only used for disabled text." },
      "500": { "$value": "#767676" },
      "600": { "$value": "#5d5d5d", "$description": "Text / Secondary." },
      "700": { "$value": "#424242" },
      "800": { "$value": "#2f2f2f" },
      "850": { "$value": "#212121" },
      "900": { "$value": "#171717" },
      "950": { "$value": "#0d0d0d", "$description": "Text / Primary." }
    },
    "green": {
      "50": { "$value": "#f3faf5" },
      "300": { "$value": "#7cc79a" },
      "600": { "$value": "#2e7d4f" },
      "700": { "$value": "#1f6b3f" },
      "900": { "$value": "#0f2a1b" }
    },
    "amber": {
      "50": { "$value": "#fffaeb" },
      "300": { "$value": "#f2b75b" },
      "600": { "$value": "#a15c00" },
      "700": { "$value": "#8a4e00" },
      "900": { "$value": "#2e1d00" }
    },
    "red": {
      "50": { "$value": "#fef5f4" },
      "200": { "$value": "#f6b1a9" },
      "300": { "$value": "#f08a80" },
      "600": { "$value": "#c2362b" },
      "700": { "$value": "#a82e24" },
      "900": { "$value": "#3a110d" }
    }
  },
  "color": {
    "$type": "color",
    "$description": "Semantic colors. Each has a light value and a dark-mode value under $extensions.",
    "bg": {
      "canvas": { "$value": "{palette.neutral.0}", "$description": "Page background.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.950}" } } } },
      "surface": { "$value": "{palette.neutral.0}", "$description": "Cards, fields and other raised surfaces.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.900}" } } } },
      "subtle": { "$value": "{palette.neutral.50}", "$description": "Quiet fills: filled cards, hover rows. Brand / Tertiary #F3F3F3.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.850}" } } } },
      "inverse": { "$value": "{palette.neutral.950}", "$description": "High-emphasis dark band (Text / Inverted pairs with it).", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.50}" } } } },
      "brand": { "$value": "{palette.orange.600}", "$description": "Primary action fill.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.orange.400}" } } } },
      "brand-hover": { "$value": "{palette.orange.700}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.orange.300}" } } } },
      "brand-subtle": { "$value": "{palette.orange.50}", "$description": "Brand-tinted backgrounds: brand tags, info alerts.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.orange.950}" } } } },
      "accent": { "$value": "{palette.orange.100}", "$description": "Soft orange highlight fill (accent tag). Pair only with color.text.on-accent.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.orange.400}" } } } },
      "danger": { "$value": "{palette.red.600}", "$description": "Destructive action fill.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.red.300}" } } } },
      "danger-hover": { "$value": "{palette.red.700}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.red.200}" } } } },
      "success-subtle": { "$value": "{palette.green.50}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.green.900}" } } } },
      "warning-subtle": { "$value": "{palette.amber.50}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.amber.900}" } } } },
      "danger-subtle": { "$value": "{palette.red.50}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.red.900}" } } } }
    },
    "text": {
      "default": { "$value": "{palette.neutral.950}", "$description": "Body text. Text / Primary #0D0D0D.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.50}" } } } },
      "muted": { "$value": "{palette.neutral.600}", "$description": "Secondary text: hints, metadata. Text / Secondary #5D5D5D.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.400}" } } } },
      "disabled": { "$value": "{palette.neutral.400}", "$description": "Disabled labels. Text / Tertiary #8F8F8F. Exempt from contrast requirements per WCAG 1.4.3.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.600}" } } } },
      "inverse": { "$value": "{palette.neutral.0}", "$description": "Text on color.bg.inverse.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.950}" } } } },
      "brand": { "$value": "{palette.orange.600}", "$description": "Links and brand-colored text.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.orange.300}" } } } },
      "on-brand": { "$value": "{palette.neutral.0}", "$description": "Text on color.bg.brand.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.950}" } } } },
      "on-accent": { "$value": "{palette.orange.800}", "$description": "Text on color.bg.accent (7.60:1).", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.950}" } } } },
      "on-danger": { "$value": "{palette.neutral.0}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.950}" } } } },
      "success": { "$value": "{palette.green.700}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.green.300}" } } } },
      "warning": { "$value": "{palette.amber.700}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.amber.300}" } } } },
      "danger": { "$value": "{palette.red.700}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.red.300}" } } } }
    },
    "border": {
      "default": { "$value": "{palette.neutral.100}", "$description": "Dividers and card outlines. Brand / Secondary #E8E8E8 (decorative, no contrast requirement).", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.800}" } } } },
      "strong": { "$value": "{palette.neutral.400}", "$description": "Form field borders: the gray #8F8F8F (3.23:1 on white). Must reach 3:1 against surfaces (WCAG 1.4.11).", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.500}" } } } },
      "brand": { "$value": "{palette.orange.600}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.orange.400}" } } } },
      "success": { "$value": "{palette.green.600}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.green.300}" } } } },
      "warning": { "$value": "{palette.amber.600}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.amber.300}" } } } },
      "danger": { "$value": "{palette.red.600}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.red.300}" } } } }
    },
    "focus": {
      "ring": { "$value": "{palette.orange.600}", "$description": "Keyboard focus outline. Must reach 3:1 against surfaces.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.orange.300}" } } } }
    }
  },
  "font": {
    "$description": "SF Pro type ramp from the product design system. Each size step has its own line height and letter spacing: use the three together (font.size.md + font.line-height.md + font.letter-spacing.md).",
    "family": {
      "$type": "fontFamily",
      "display": { "$value": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro\", system-ui, \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif", "$description": "Headings. SF Pro Display where available (Apple platforms); SF Pro can't be self-hosted, so other platforms fall back to their system UI font." },
      "body": { "$value": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro\", system-ui, \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif", "$description": "UI and body copy. SF Pro Text, with the same system fallbacks." },
      "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400, "$description": "Regular text." },
      "medium": { "$value": 500, "$description": "Outside the base ramp. Kept for the Text weight prop; prefer regular or semibold." },
      "semibold": { "$value": 600, "$description": "Headings and emphasized text." },
      "bold": { "$value": 700, "$description": "Outside the base ramp. Kept for the Text weight prop; prefer semibold." }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px · caption" },
      "sm": { "$value": "0.875rem", "$description": "14px · body-small" },
      "md": { "$value": "1rem", "$description": "16px · body" },
      "lg": { "$value": "1.125rem", "$description": "18px · heading3" },
      "xl": { "$value": "1.5rem", "$description": "24px · heading2" },
      "2xl": { "$value": "2.25rem", "$description": "36px · heading1" }
    },
    "line-height": {
      "$type": "dimension",
      "xs": { "$value": "1rem", "$description": "16px" },
      "sm": { "$value": "1.125rem", "$description": "18px" },
      "md": { "$value": "1.625rem", "$description": "26px" },
      "lg": { "$value": "1.625rem", "$description": "26px" },
      "xl": { "$value": "1.75rem", "$description": "28px" },
      "2xl": { "$value": "2.5rem", "$description": "40px" }
    },
    "letter-spacing": {
      "$type": "dimension",
      "xs": { "$value": "-0.1px" },
      "sm": { "$value": "-0.3px" },
      "md": { "$value": "-0.4px" },
      "lg": { "$value": "-0.45px" },
      "xl": { "$value": "-0.25px" },
      "2xl": { "$value": "-0.1px" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid, in rem so it scales with user font settings.",
    "0": { "$value": "0" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$description": "Heights for buttons and fields. md and lg meet the 44px-ish touch target guidance; sm is for dense desktop UI.",
      "sm": { "$value": "2rem" },
      "md": { "$value": "2.5rem" },
      "lg": { "$value": "3rem" }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Everything is rounded. Controls (buttons, fields, tags) are pills; containers (cards, alerts) use lg.",
    "none": { "$value": "0" },
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "16px", "$description": "Cards and alerts." },
    "pill": { "$value": "9999px", "$description": "Buttons, text fields and tags." }
  },
  "border-width": {
    "$type": "dimension",
    "thin": { "$value": "1px" },
    "thick": { "$value": "2px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 2px rgba(5, 5, 5, 0.08)" },
    "md": { "$value": "0 4px 12px rgba(5, 5, 5, 0.10)" },
    "lg": { "$value": "0 12px 32px rgba(5, 5, 5, 0.14)" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  }
}
