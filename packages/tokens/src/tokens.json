{
  "$description": "Wayfind design tokens (W3C DTCG format). Single source of truth for CSS, the React library, Storybook and the MCP server. Primitives live under `palette`; components only consume semantic `color.*` tokens and the scales.",
  "palette": {
    "$type": "color",
    "$description": "Primitive colors. Never referenced directly by components — use semantic `color.*` tokens instead.",
    "teal": {
      "$description": "Brand hue, built around #31A3B4 from xueweijiang.com. Scale generated in OKLCH so steps feel perceptually even.",
      "50": { "$value": "#eef9fb" },
      "100": { "$value": "#d7f0f4" },
      "200": { "$value": "#b3e2e9" },
      "300": { "$value": "#84cdd8" },
      "400": { "$value": "#55b7c6" },
      "500": { "$value": "#31a3b4", "$description": "The original brand teal. 2.99:1 on white, so it is used for accents and dark-on-teal surfaces, never for text on white." },
      "600": { "$value": "#267f8c", "$description": "Darkest step that keeps the brand feel while passing AA (4.67:1) with white text." },
      "700": { "$value": "#1e6570" },
      "800": { "$value": "#164d56" },
      "900": { "$value": "#0f363d" },
      "950": { "$value": "#092428" }
    },
    "neutral": {
      "$description": "Grays anchored on the site's #333333 body text and #050505 near-black.",
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f7f7f7" },
      "100": { "$value": "#efefef" },
      "200": { "$value": "#e2e2e2" },
      "300": { "$value": "#cccccc" },
      "400": { "$value": "#aaaaaa", "$description": "The site's muted gray. Only 2.32:1 on white, so it is not used for text in light mode." },
      "500": { "$value": "#8a8a8a" },
      "600": { "$value": "#6b6b6b" },
      "700": { "$value": "#4d4d4d" },
      "800": { "$value": "#333333" },
      "850": { "$value": "#262626" },
      "900": { "$value": "#1a1a1a" },
      "950": { "$value": "#050505" }
    },
    "green": {
      "50": { "$value": "#eaf6ee" },
      "300": { "$value": "#7cc79a" },
      "600": { "$value": "#2e7d4f" },
      "700": { "$value": "#1f6b3f" },
      "900": { "$value": "#0f2a1b" }
    },
    "amber": {
      "50": { "$value": "#fff5e0" },
      "300": { "$value": "#f2b75b" },
      "600": { "$value": "#a15c00" },
      "700": { "$value": "#8a4e00" },
      "900": { "$value": "#2e1d00" }
    },
    "red": {
      "50": { "$value": "#fdecea" },
      "200": { "$value": "#f6b1a9" },
      "300": { "$value": "#f08a80" },
      "600": { "$value": "#c2362b" },
      "700": { "$value": "#a82e24" },
      "900": { "$value": "#3a110d" }
    }
  },
  "color": {
    "$type": "color",
    "$description": "Semantic colors. Each has a light value and a dark-mode value under $extensions.",
    "bg": {
      "canvas": { "$value": "{palette.neutral.0}", "$description": "Page background.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.950}" } } } },
      "surface": { "$value": "{palette.neutral.0}", "$description": "Cards, fields and other raised surfaces.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.900}" } } } },
      "subtle": { "$value": "{palette.neutral.50}", "$description": "Quiet fills: filled cards, hover rows.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.850}" } } } },
      "inverse": { "$value": "{palette.neutral.950}", "$description": "High-emphasis dark band, like the site footer.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.50}" } } } },
      "brand": { "$value": "{palette.teal.600}", "$description": "Primary action fill.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.teal.400}" } } } },
      "brand-hover": { "$value": "{palette.teal.700}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.teal.300}" } } } },
      "brand-subtle": { "$value": "{palette.teal.50}", "$description": "Brand-tinted backgrounds: brand tags, info alerts.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.teal.950}" } } } },
      "accent": { "$value": "{palette.teal.500}", "$description": "The original brand teal for decorative surfaces. Pair only with color.text.on-accent.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.teal.500}" } } } },
      "danger": { "$value": "{palette.red.600}", "$description": "Destructive action fill.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.red.300}" } } } },
      "danger-hover": { "$value": "{palette.red.700}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.red.200}" } } } },
      "success-subtle": { "$value": "{palette.green.50}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.green.900}" } } } },
      "warning-subtle": { "$value": "{palette.amber.50}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.amber.900}" } } } },
      "danger-subtle": { "$value": "{palette.red.50}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.red.900}" } } } }
    },
    "text": {
      "default": { "$value": "{palette.neutral.800}", "$description": "Body text. Matches the site's #333333.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.50}" } } } },
      "muted": { "$value": "{palette.neutral.600}", "$description": "Secondary text: hints, metadata.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.400}" } } } },
      "disabled": { "$value": "{palette.neutral.400}", "$description": "Disabled labels. Exempt from contrast requirements per WCAG 1.4.3.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.600}" } } } },
      "inverse": { "$value": "{palette.neutral.0}", "$description": "Text on color.bg.inverse.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.950}" } } } },
      "brand": { "$value": "{palette.teal.700}", "$description": "Links and brand-colored text.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.teal.300}" } } } },
      "on-brand": { "$value": "{palette.neutral.0}", "$description": "Text on color.bg.brand.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.950}" } } } },
      "on-accent": { "$value": "{palette.neutral.950}", "$description": "Text on color.bg.accent (6.82:1).", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.950}" } } } },
      "on-danger": { "$value": "{palette.neutral.0}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.950}" } } } },
      "success": { "$value": "{palette.green.700}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.green.300}" } } } },
      "warning": { "$value": "{palette.amber.700}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.amber.300}" } } } },
      "danger": { "$value": "{palette.red.700}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.red.300}" } } } }
    },
    "border": {
      "default": { "$value": "{palette.neutral.200}", "$description": "Dividers and card outlines (decorative, no contrast requirement).", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.800}" } } } },
      "strong": { "$value": "{palette.neutral.500}", "$description": "Form field borders. Must reach 3:1 against surfaces (WCAG 1.4.11).", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.neutral.500}" } } } },
      "brand": { "$value": "{palette.teal.600}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.teal.400}" } } } },
      "success": { "$value": "{palette.green.600}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.green.300}" } } } },
      "warning": { "$value": "{palette.amber.600}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.amber.300}" } } } },
      "danger": { "$value": "{palette.red.600}", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.red.300}" } } } }
    },
    "focus": {
      "ring": { "$value": "{palette.teal.600}", "$description": "Keyboard focus outline. Must reach 3:1 against surfaces.", "$extensions": { "dev.wayfind": { "modes": { "dark": "{palette.teal.300}" } } } }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": "\"Chivo\", \"Helvetica Neue\", Arial, sans-serif", "$description": "Headlines. Chivo Black with wide tracking, as on xueweijiang.com." },
      "body": { "$value": "\"Overpass\", \"Helvetica Neue\", Arial, sans-serif", "$description": "UI and body copy. Open-source stand-in for Interstate (the site's licensed Typekit font); both descend from US highway signage." },
      "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "black": { "$value": 900 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.25rem" },
      "xl": { "$value": "1.75rem" },
      "2xl": { "$value": "2.25rem" },
      "3xl": { "$value": "3rem" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.4 },
      "normal": { "$value": 1.6 },
      "relaxed": { "$value": 1.8 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "normal": { "$value": "0" },
      "wide": { "$value": "0.04em", "$description": "Body copy on the portfolio site runs at ~0.06em; UI text is a touch tighter." },
      "display": { "$value": "0.07em", "$description": "Matches the portfolio's headline tracking." }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid, in rem so it scales with user font settings.",
    "0": { "$value": "0" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$description": "Heights for buttons and fields. md and lg meet the 44px-ish touch target guidance; sm is for dense desktop UI.",
      "sm": { "$value": "2rem" },
      "md": { "$value": "2.5rem" },
      "lg": { "$value": "3rem" }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Mostly square, like exhibition signage. Rounding is reserved for pills.",
    "none": { "$value": "0" },
    "sm": { "$value": "2px" },
    "md": { "$value": "4px" },
    "lg": { "$value": "8px" },
    "pill": { "$value": "9999px" }
  },
  "border-width": {
    "$type": "dimension",
    "thin": { "$value": "1px" },
    "thick": { "$value": "2px" },
    "accent": { "$value": "4px", "$description": "Leading edge on alerts, like a gallery wall label." }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 2px rgba(5, 5, 5, 0.08)" },
    "md": { "$value": "0 4px 12px rgba(5, 5, 5, 0.10)" },
    "lg": { "$value": "0 12px 32px rgba(5, 5, 5, 0.14)" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  }
}
